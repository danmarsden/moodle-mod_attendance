{
    "name": "mod_attendance Moodle Development",
    "dockerComposeFile": "docker-compose.yml",
    "service": "webserver",
    "workspaceFolder": "/workspaces/moodle-mod_attendance",
    "postCreateCommand": "bash /workspaces/moodle-mod_attendance/.devcontainer/setup.sh",
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "Moodle",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "xdebug.php-debug",
                "bmewburn.vscode-intelephense-client",
                "EditorConfig.EditorConfig",
                "calebporzio.better-phpunit",
                "DEVSENSE.phptools-vscode",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php",
                "intelephense.environment.phpVersion": "8.3.0",
                "intelephense.environment.includePaths": [
                    "/var/www/html"
                ],
                "php.debug.executablePath": "/usr/local/bin/php",
                "launch": {
                    "configurations": [
                        {
                            "name": "Listen for Xdebug",
                            "type": "php",
                            "request": "launch",
                            "port": 9003,
                            "pathMappings": {
                                "/var/www/html/mod/attendance": "${workspaceFolder}"
                            }
                        }
                    ]
                }
            }
        }
    }
}
